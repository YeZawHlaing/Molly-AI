{
  "manifest_version": 3,
  "name": "Molly AI Copilot",
  "version": "1.0",
  "description": "Molly stands on the corner of your webpages.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/molly.png"],
      "matches": ["<all_urls>"]
    }
  ]
}